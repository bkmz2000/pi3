# Auth provider selector: loginus | keycloak (default: loginus)
AUTH_PROVIDER=loginus

# Base URL of the app — used to build the OAuth redirect URI (/api/auth/callback).
# In production set this to the public domain. Omit for local dev (defaults to http://localhost:3001).
APP_BASE_URL=https://pi3.sys5.ru

# Loginus OAuth (AUTH_PROVIDER=loginus)
LOGINUS_DOMAIN=https://loginus.ru
LOGINUS_CLIENT_ID=c7311411f2e40a2a66f3ecabff36c836
LOGINUS_CLIENT_SECRET=your-client-secret-here
LOGINUS_TEACHER_ROLE=teacher

# Keycloak OIDC (AUTH_PROVIDER=keycloak)
# Callback URL to register in realm client: ${APP_BASE_URL}/api/auth/callback
# For roles, configure a "User Realm Role" userinfo mapper (or rely on realm_access.roles).
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=pi3
KEYCLOAK_CLIENT_ID=your-keycloak-client-id
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
KEYCLOAK_TEACHER_ROLE=teacher

# Session
SESSION_SECRET=change-this-to-a-long-random-string

# Database (optional, defaults to pi3.db in cwd)
# DB_PATH=/path/to/pi3.db

# Server port (optional, defaults to 3001)
# PORT=3001

# ── Vercel / Turso / Upstash (uncomment for Vercel deployment) ────────
# Presence of TURSO_DATABASE_URL makes `make deploy` auto-target Vercel.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
# UPSTASH_REDIS_URL=rediss://default:password@host.upstash.io:6380
