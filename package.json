{
  "name": "pi3-ide",
  "private": false,
  "version": "1.0.0",
  "description": "A browser-based Python IDE for teaching kids aged 10-12",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_GITHUB/pi3-ide"
  },
  "homepage": "https://github.com/YOUR_GITHUB/pi3-ide#readme",
  "keywords": [
    "python",
    "ide",
    "education",
    "kids",
    "graphics",
    "pyodide",
    "pwa"
  ],
  "type": "module",
  "scripts": {
    "setup:pyodide": "node scripts/copy-pyodide.mjs",
    "predev": "node scripts/copy-pyodide.mjs",
    "predev:all": "node scripts/copy-pyodide.mjs",
    "prebuild": "node scripts/copy-pyodide.mjs",
    "prepreview": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "dev:all": "concurrently -n fe,api -c cyan,green \"vite\" \"node --env-file=.env --import tsx server/index.ts\"",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node --import tsx server/index.ts",
    "test:puppeteer": "node tests/puppeteer/production-test-suite.js",
    "test:smoke": "node tests/puppeteer/ide-smoke-test.js",
    "test:comprehensive": "node tests/puppeteer/ide-comprehensive-test.js",
    "test:sprite": "node tests/puppeteer/sprite-editor-test-runner.js",
    "test:runner": "node tests/run-tests.js",
    "test": "jest",
    "test:ci": "jest --coverage",
    "test:server:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config server/tests/jest.server.config.js --rootDir . --coverage",
    "test:unit": "jest",
    "test:server": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config server/tests/jest.server.config.js --rootDir .",
    "test:watch": "jest --watch",
    "test:docker": "bash scripts/test-docker.sh"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lint": "^6.9.6",
    "@tailwindcss/vite": "^4.2.1",
    "@uiw/codemirror-theme-github": "^4.25.9",
    "@uiw/react-codemirror": "^4.25.7",
    "animal-avatar-generator": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-session": "^1.19.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "jszip": "^3.10.1",
    "konva": "^10.2.1",
    "lucide-react": "^1.16.0",
    "pyodide": "^0.29.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.0",
    "react-icons": "^5.6.0",
    "react-konva": "^19.2.3",
    "react-router-dom": "^7.14.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.19.0",
    "uuid": "^11.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@jest/globals": "^30.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "@types/puppeteer": "^7.0.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "puppeteer": "^23.1.1",
    "serve": "^14.2.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "ws": "^8.19.0"
  },
  "overrides": {
    "@codemirror/highlight": "^1.2.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.16"
  }
}
